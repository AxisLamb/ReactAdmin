# ============================================================
# 生产环境统一环境变量（docker-compose 各服务共用，禁止提交到 git）
# ============================================================

# ---------- Redis ----------
# 应用连接 Redis 的密码（application-prod.yml ${REDIS_PASSWORD}）
# 注意：若 redis 容器未启用 requirepass（docker-compose 中 command 被注释），
#       本项留空即可（应用不发送 AUTH）；启用密码后需填写并保持一致
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Druid 监控台 ----------
DRUID_MONITOR_PASSWORD=123456

# ---------- MinIO（docker-compose 未部署时可不填，但变量必须存在否则启动报错） ----------
MINIO_ACCESS_KEY=xxx
MINIO_SECRET_KEY=xxx

# ---------- MySQL（mysql-db 容器初始化用，首次启动数据卷生效） ----------
# root 账号密码（必填，MySQL 镜像要求）
MYSQL_ROOT_PASSWORD=123456
# 容器启动时自动创建的数据库
MYSQL_DATABASE=lain_db
MYSQL_HOST=mysql-db
MYSQL_PORT=3306

# 时区
TZ=Asia/Shanghai

# 应用连接 MySQL 的密码（application-prod.yml ${MYSQL_PASSWORD}，应用以 root 连接，与 MYSQL_ROOT_PASSWORD 保持一致）
MYSQL_PASSWORD=123456

# ---------- 阿里云 OSS ----------
ALIYUN_OSS_ENDPOINT=xxx
ALIYUN_OSS_ACCESS_KEY_ID=xxx
ALIYUN_OSS_ACCESS_KEY_SECRET=xxx

# ---------- Nginx ----------
NGINX_HOST=system.reactadminfront.com
DOCKER_REQUEST_DOMAIN_PREFIX=http://react-admin:8888/
